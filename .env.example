# ============================================
# DANURI Solution - Environment Variables
# ============================================

# --------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------
DATABASE_URL=postgresql://danuri:danuri_password@localhost:5432/danuri_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=danuri_db
DB_USER=danuri
DB_PASSWORD=danuri_password

# --------------------------------------------
# API Server
# --------------------------------------------
API_HOST=localhost
API_PORT=3030
NODE_ENV=development

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------
# RSA Key Encryption
# --------------------------------------------
RSA_PASSPHRASE=your-rsa-passphrase-for-private-key-encryption

# --------------------------------------------
# Mail (SMTP)
# --------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@danuri.go.kr
SMTP_PASS=your-smtp-password
MAIL_FROM=DANURI <noreply@danuri.go.kr>

# --------------------------------------------
# Admin Server
# --------------------------------------------
ADMIN_PORT=8080
ADMIN_SESSION_SECRET=your-admin-session-secret

# --------------------------------------------
# URLs (Production)
# --------------------------------------------
ADMIN_URL=http://localhost:8080
API_URL=http://localhost:3030
CDN_URL=http://localhost:3030/static

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=debug

# --------------------------------------------
# Redis (Optional - for session/cache)
# --------------------------------------------
# REDIS_URL=redis://localhost:6379
