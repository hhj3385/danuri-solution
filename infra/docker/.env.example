# DANURI ITSM v2.0 - Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env file to version control

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=danuri_itsm
POSTGRES_USER=danuri
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_MIN_16_CHARS
POSTGRES_PORT=5432

# ============================================
# Core API Configuration
# ============================================
NODE_ENV=production
API_PORT=3030
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_RANDOM_STRING

# ============================================
# User Portal Configuration
# ============================================
USER_PORTAL_PORT=3000
# Client-side URL (browser access) - use your actual domain or IP
NEXT_PUBLIC_API_URL=http://localhost:3030

# ============================================
# Admin Console Configuration
# ============================================
ADMIN_CONSOLE_PORT=8080
SPRING_PROFILES_ACTIVE=prod
