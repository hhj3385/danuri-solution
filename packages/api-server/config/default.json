{
  "host": "localhost",
  "port": 3030,
  "public": "../public/",
  "paginate": {
    "default": 10,
    "max": 50
  },
  "postgresql": {
    "client": "pg",
    "connection": {
      "host": "localhost",
      "port": 5432,
      "database": "danuri_db",
      "user": "danuri",
      "password": "danuri_password"
    },
    "pool": {
      "min": 2,
      "max": 10
    }
  },
  "authentication": {
    "entity": "user",
    "service": "users",
    "secret": "CHANGE_THIS_SECRET_IN_PRODUCTION",
    "authStrategies": ["jwt"],
    "jwtOptions": {
      "header": {
        "typ": "access"
      },
      "audience": "https://danuri.go.kr",
      "issuer": "danuri",
      "algorithm": "HS256",
      "expiresIn": "1h"
    }
  },
  "mail": {
    "smtp": {
      "host": "smtp.example.com",
      "port": 587,
      "secure": false,
      "auth": {
        "user": "noreply@danuri.go.kr",
        "pass": "smtp_password"
      }
    },
    "from": "DANURI <noreply@danuri.go.kr>"
  },
  "rsa": {
    "passphrase": "CHANGE_THIS_PASSPHRASE"
  }
}
